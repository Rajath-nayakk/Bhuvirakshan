# Environment Variables Example for Forest & River Guardian
# Copy to .env and fill in real credentials when deploying.

# Earth Engine & Satellite Access
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY_PATH=
COPERNICUS_USER=
COPERNICUS_PASSWORD=

# Security & Authentication
JWT_SECRET=super_secret_guardian_key_replace_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin / Ranger Credentials
INITIAL_ADMIN_EMAIL=admin@guardian.internal
INITIAL_ADMIN_PASSWORD=ForestGuardianAdmin2026!
INITIAL_RANGER_EMAIL=ranger@guardian.internal
INITIAL_RANGER_PASSWORD=RangerPatrol2026!

# Database & Storage
DATABASE_URL=sqlite:///./data/guardian.db
MLFLOW_TRACKING_URI=./data/mlruns
OFFLINE_DEMO_MODE=true

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
